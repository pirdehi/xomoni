{
  "name": "xomoni",
  "version": "0.1.0",
  "private": true,
  "description": "Manage and clean up your own X (Twitter) account from a local dashboard — no API keys, rate-limit aware.",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/build-content.mjs",
    "watch": "node scripts/watch.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "preview:ui": "vite --open /preview.html"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.0"
  }
}
