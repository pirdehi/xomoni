# Supabase project (Settings → API Keys), or the local stack (`supabase status`).
# Both values are public by design; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public origin of this deployment; OAuth and email links come back here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key for the auth forms (public). For local development and CI use
# Cloudflare's always-pass test key below; it matches the test secret in supabase/config.toml.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# End-to-end tests only (#302): the id of the test extension with a fixed key that Playwright loads
# (e2e/fixtures/fixed-id-extension); playwright.config.ts sets it. The site asks it for Xomoni after the
# stores' ids, and only while NEXT_PUBLIC_SITE_URL is on localhost. Leave it empty everywhere else.
NEXT_PUBLIC_XOMONI_TEST_EXTENSION_ID=
# Only in the end-to-end tests' build (playwright.config.ts sets it to 1): lets a test choose the store listings
# /install shows, before the stores list Xomoni (#304). Leave it empty everywhere else, Vercel included.
NEXT_PUBLIC_E2E_STORE_LISTINGS=
