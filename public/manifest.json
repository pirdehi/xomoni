{
  "manifest_version": 3,
  "name": "Xomoni — X Account Manager",
  "short_name": "Xomoni",
  "version": "0.1.0",
  "description": "Clean up your own X account — delete old posts, replies, reposts and likes from a local dashboard. No API keys, rate-limit aware.",
  "homepage_url": "https://github.com/pirdehi/xomoni",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "notifications"],
  "host_permissions": ["https://x.com/*"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": {
    "default_title": "Open Xomoni dashboard",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
