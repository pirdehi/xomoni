# Supabase project (Settings → API Keys), or the local stack (`supabase status`).
# Both values are public by design; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public origin of this deployment; OAuth and email links come back here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key for the auth forms (public). For local development and CI use
# Cloudflare's always-pass test key below; it matches the test secret in supabase/config.toml.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
