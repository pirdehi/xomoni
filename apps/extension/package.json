{
  "name": "@xomoni/extension",
  "version": "0.1.0",
  "private": true,
  "description": "The Xomoni Chrome extension (MV3): cleans up your own X account by driving X's own UI, paced to stay within X's limits.",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/build-content.mjs",
    "watch": "node scripts/watch.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "preview:ui": "vite --open /preview.html"
  },
  "dependencies": {
    "@xomoni/consent": "*",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
